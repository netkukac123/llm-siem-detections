<!--
  LLM application detections for Wazuh 4.x  (rule IDs 100700-100799)

  Input: one JSON object per line as described in docs/log-schema.md, read by the
  agent with <log_format>json</log_format> (see ossec-localfile.conf).
  Every alerting rule carries group llmd_NNN for the LLMD rule(s) it implements,
  so the same IDs work across Sentinel and Wazuh.

  Wazuh emits one alert per event, the deepest matching rule. Combined child rules
  carry several llmd groups for the overlaps seen in practice (injection plus
  extraction, exfiltrating call plus secret). Other overlaps report only one of
  the applicable LLMD rules; see docs/coverage.md, "Wazuh and Sentinel differences".

  Regexes run in PCRE2 without UTF mode, so non-ASCII characters are written as
  literal UTF-8 sequences or byte ranges.
-->
<group name="llm_app,">

  <!-- ===== Base: recognise the event family ===== -->
  <rule id="100700" level="0">
    <decoded_as>json</decoded_as>
    <field name="event_type" type="pcre2">^(prompt|guardrail|retrieval|tool_call|completion|memory_write|tool_registry|reasoning|refusal)$</field>
    <field name="request_id" type="pcre2">^\w+$</field>
    <description>LLM app event.</description>
  </rule>

  <rule id="100701" level="0">
    <if_sid>100700</if_sid>
    <field name="event_type">^prompt$</field>
    <description>LLM app: user prompt.</description>
  </rule>

  <rule id="100702" level="3">
    <if_sid>100700</if_sid>
    <field name="event_type">^guardrail$</field>
    <field name="guardrail_action">^block$</field>
    <description>LLM app: guardrail blocked a prompt from $(user_id) ($(guardrail_rule)).</description>
    <group>llm_guardrail_block,</group>
  </rule>

  <rule id="100703" level="0">
    <if_sid>100700</if_sid>
    <field name="event_type">^retrieval$</field>
    <description>LLM app: document retrieved into context.</description>
  </rule>

  <!-- Level 2, not 0: frequency rules only count events from rules with level > 0.
       Still below the default log_alert_level of 3, so it produces no alert. -->
  <rule id="100704" level="2">
    <if_sid>100700</if_sid>
    <field name="event_type">^tool_call$</field>
    <description>LLM app: agent tool call.</description>
    <group>llm_tool_call,</group>
  </rule>

  <rule id="100706" level="0">
    <if_sid>100700</if_sid>
    <field name="event_type">^reasoning$</field>
    <description>LLM app: model reasoning trace.</description>
  </rule>

  <rule id="100707" level="0">
    <if_sid>100700</if_sid>
    <field name="event_type">^refusal$</field>
    <description>LLM app: model refusal signal.</description>
  </rule>

  <rule id="100705" level="0">
    <if_sid>100700</if_sid>
    <field name="event_type">^completion$</field>
    <description>LLM app: model completion.</description>
  </rule>

  <!-- ===== Prompt-side rules ===== -->

  <!-- LLMD-001 Direct prompt injection phrasing -->
  <rule id="100710" level="8">
    <if_sid>100701</if_sid>
    <field name="prompt" type="pcre2">(?i)\b(ignore|disregard|forget|override)\b[^.\n]{0,30}\b(previous|prior|above|earlier|preceding|system)\b[^.\n]{0,20}\b(instructions?|prompts?|rules|directions|guidelines)\b|\bnew instructions?\s*:|\byou are now\b[^.\n]{0,30}\b(unrestricted|unfiltered|uncensored)\b|(felejtsd el|hagyd figyelmen k(i|í)v(u|ü)l|ne vedd figyelembe).{0,30}(kor(a|á)bbi|el(o|ő)z(o|ő)|fenti|eddigi).{0,15}utas(i|í)t(a|á)s</field>
    <description>LLMD-001 Direct prompt injection phrasing from $(user_id).</description>
    <group>llmd_001,owasp_llm01,atlas_AML.T0051.000,</group>
  </rule>

  <!-- LLMD-001 + LLMD-012 on the same prompt -->
  <rule id="100711" level="10">
    <if_sid>100710</if_sid>
    <field name="prompt" type="pcre2">(?i)\b(repeat|print|reveal|show|output|display|dump)\b[^.\n]{0,25}\b(system prompt|instructions|the text above|everything above|initial prompt|hidden prompt)\b|\bwhat (are|were) your (original |initial |system |hidden )?(instructions|rules|prompt)\b|\brepeat the (text|words) above\b</field>
    <description>LLMD-001/LLMD-012 Prompt injection combined with system prompt extraction from $(user_id).</description>
    <group>llmd_001,llmd_012,owasp_llm01,owasp_llm07,atlas_AML.T0051.000,atlas_AML.T0056,</group>
  </rule>

  <!-- LLMD-012 System prompt extraction attempt -->
  <rule id="100712" level="5">
    <if_sid>100701</if_sid>
    <field name="prompt" type="pcre2">(?i)\b(repeat|print|reveal|show|output|display|dump)\b[^.\n]{0,25}\b(system prompt|instructions|the text above|everything above|initial prompt|hidden prompt)\b|\bwhat (are|were) your (original |initial |system |hidden )?(instructions|rules|prompt)\b|\brepeat the (text|words) above\b</field>
    <description>LLMD-012 System prompt extraction attempt from $(user_id).</description>
    <group>llmd_012,owasp_llm07,atlas_AML.T0056,</group>
  </rule>

  <!-- LLMD-011 Obfuscated prompt content -->
  <rule id="100713" level="8">
    <if_sid>100701</if_sid>
    <field name="prompt" type="pcre2">\xF3\xA0[\x80\x81][\x80-\xBF]</field>
    <description>LLMD-011 Invisible Unicode tag characters (ASCII smuggling) in prompt from $(user_id).</description>
    <group>llmd_011,owasp_llm01,atlas_AML.T0068,</group>
  </rule>

  <rule id="100714" level="8">
    <if_sid>100701</if_sid>
    <!-- Run must start at a boundary and contain both cases, so hex digests do not match -->
    <field name="prompt" type="pcre2">(?:^|[^A-Za-z0-9+/])(?=[A-Za-z0-9+/]*[A-Z])(?=[A-Za-z0-9+/]*[a-z])[A-Za-z0-9+/]{60,}={0,2}</field>
    <description>LLMD-011 Long base64 blob in prompt from $(user_id).</description>
    <group>llmd_011,owasp_llm01,atlas_AML.T0068,</group>
  </rule>

  <rule id="100715" level="8">
    <if_sid>100701</if_sid>
    <field name="prompt" type="pcre2">(\xE2\x80[\x8B-\x8D]|\xE2\x81\xA0|\xEF\xBB\xBF){3,}</field>
    <description>LLMD-011 Run of zero-width characters in prompt from $(user_id).</description>
    <group>llmd_011,owasp_llm01,atlas_AML.T0068,</group>
  </rule>

  <!-- LLMD-010 Repeated guardrail blocks (3 in 10 minutes, same user) -->
  <rule id="100716" level="10" frequency="3" timeframe="600">
    <if_matched_sid>100702</if_matched_sid>
    <same_field>user_id</same_field>
    <description>LLMD-010 Repeated guardrail blocks from $(user_id): likely jailbreak iteration.</description>
    <group>llmd_010,owasp_llm01,atlas_AML.T0054,</group>
  </rule>

  <!-- ===== Retrieval-side rules ===== -->

  <!-- Externally sourced content entered the context (correlation anchor for LLMD-007) -->
  <rule id="100720" level="3">
    <if_sid>100703</if_sid>
    <field name="doc_source" negate="yes">^internal-wiki$</field>
    <description>LLM app: external document $(doc_id) retrieved into context.</description>
    <group>llm_external_content,</group>
  </rule>

  <!-- LLMD-002 Instructions aimed at the model inside retrieved content (external source) -->
  <rule id="100721" level="8">
    <if_sid>100720</if_sid>
    <field name="chunk_text" type="pcre2">(?i)\b(ignore|disregard|forget|override)\b[^.\n]{0,30}\b(previous|prior|above|earlier|preceding|system)\b[^.\n]{0,20}\b(instructions?|prompts?|rules|directions|guidelines)\b|\bnew instructions?\s*:|\b(note|message|instructions?) (to|for) the (ai|assistant|ai assistant|llm|model)\b|\bassistant instructions\s*:|\b(ai|llm) (assistant|agent)\s*:|!\[[^\]]*\]\(https?://[^)\s]*\{[^}]*\}</field>
    <description>LLMD-002 Retrieved document $(doc_id) ($(doc_source)) contains instructions aimed at the model.</description>
    <group>llmd_002,llm_external_content,owasp_llm01,owasp_llm08,atlas_AML.T0051.001,atlas_AML.T0070,</group>
  </rule>

  <!-- LLMD-002 same check for internal documents -->
  <rule id="100722" level="8">
    <if_sid>100703</if_sid>
    <field name="doc_source">^internal-wiki$</field>
    <field name="chunk_text" type="pcre2">(?i)\b(ignore|disregard|forget|override)\b[^.\n]{0,30}\b(previous|prior|above|earlier|preceding|system)\b[^.\n]{0,20}\b(instructions?|prompts?|rules|directions|guidelines)\b|\bnew instructions?\s*:|\b(note|message|instructions?) (to|for) the (ai|assistant|ai assistant|llm|model)\b|\bassistant instructions\s*:|\b(ai|llm) (assistant|agent)\s*:|!\[[^\]]*\]\(https?://[^)\s]*\{[^}]*\}</field>
    <description>LLMD-002 Retrieved document $(doc_id) ($(doc_source)) contains instructions aimed at the model.</description>
    <group>llmd_002,owasp_llm01,owasp_llm08,atlas_AML.T0051.001,atlas_AML.T0070,</group>
  </rule>

  <!-- ===== Tool-call rules ===== -->

  <!-- LLMD-006 Side-effecting tool aimed at an external destination -->
  <rule id="100730" level="8">
    <if_sid>100704</if_sid>
    <field name="tool_name">^send_email$|^http_get$</field>
    <field name="tool_target" type="pcre2" negate="yes">(?i)(^|\.)acme-freight\.hu$|^learn\.microsoft\.com$|^github\.com$</field>
    <description>LLMD-006 Agent called $(tool_name) towards external target $(tool_target).</description>
    <group>llm_tool_call,llmd_006,llm_egress_external,owasp_llm06,atlas_AML.T0053,atlas_AML.T0086,</group>
  </rule>

  <!-- LLMD-007 Egress after external content in the same session (10 min) -->
  <rule id="100731" level="12" timeframe="600">
    <if_sid>100730</if_sid>
    <if_matched_group>llm_external_content</if_matched_group>
    <same_field>session_id</same_field>
    <description>LLMD-007 Egress tool call to $(tool_target) after external content entered session $(session_id): probable indirect prompt injection.</description>
    <group>llm_tool_call,llmd_006,llmd_007,owasp_llm01,owasp_llm06,atlas_AML.T0051.001,atlas_AML.T0086,</group>
  </rule>

  <!-- LLMD-004 on top of LLMD-006/007: the exfiltrating call carries a secret -->
  <rule id="100732" level="13">
    <if_sid>100731</if_sid>
    <field name="tool_args" type="pcre2">\b(AKIA|ASIA)[0-9A-Z]{16}\b|(?i:secret)[^\n]{0,20}[A-Za-z0-9/+]{40}|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bgh[pousr]_[A-Za-z0-9]{36}\b|\bxox[baprs]-[A-Za-z0-9-]{10,}|\bHU\d{2}(?: ?\d{4}){6}\b</field>
    <description>LLMD-004/006/007 Secret sent to $(tool_target) via $(tool_name) after external content entered the session.</description>
    <group>llm_tool_call,llmd_004,llmd_006,llmd_007,owasp_llm02,owasp_llm06,atlas_AML.T0057,atlas_AML.T0086,</group>
  </rule>

  <!-- ...and the data was read from a private file earlier in the same turn (LLMD-019) -->
  <rule id="100784" level="14" timeframe="300">
    <if_sid>100732</if_sid>
    <if_matched_group>llm_private_read</if_matched_group>
    <same_field>request_id</same_field>
    <description>LLMD-004/006/007/019 Private file read and its secrets sent to $(tool_target) after external content entered the session.</description>
    <group>llm_tool_call,llmd_004,llmd_006,llmd_007,llmd_019,owasp_llm02,owasp_asi01,owasp_asi02,atlas_AML.T0057,atlas_AML.T0086,</group>
  </rule>

  <rule id="100733" level="12">
    <if_sid>100730</if_sid>
    <field name="tool_args" type="pcre2">\b(AKIA|ASIA)[0-9A-Z]{16}\b|(?i:secret)[^\n]{0,20}[A-Za-z0-9/+]{40}|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bgh[pousr]_[A-Za-z0-9]{36}\b|\bxox[baprs]-[A-Za-z0-9-]{10,}|\bHU\d{2}(?: ?\d{4}){6}\b</field>
    <description>LLMD-004/006 Secret sent to external target $(tool_target) via $(tool_name).</description>
    <group>llm_tool_call,llmd_004,llmd_006,owasp_llm02,owasp_llm06,atlas_AML.T0057,atlas_AML.T0086,</group>
  </rule>

  <!-- Egress tool to a trusted destination: not LLMD-006, but still checked for secrets -->
  <rule id="100737" level="0">
    <if_sid>100704</if_sid>
    <field name="tool_name">^send_email$|^http_get$</field>
    <field name="tool_target" type="pcre2">(?i)(^|\.)acme-freight\.hu$|^learn\.microsoft\.com$|^github\.com$</field>
    <description>LLM app: agent egress tool call to trusted target $(tool_target).</description>
    <group>llm_tool_call,</group>
  </rule>

  <rule id="100738" level="10">
    <if_sid>100737</if_sid>
    <field name="tool_args" type="pcre2">\b(AKIA|ASIA)[0-9A-Z]{16}\b|(?i:secret)[^\n]{0,20}[A-Za-z0-9/+]{40}|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bgh[pousr]_[A-Za-z0-9]{36}\b|\bxox[baprs]-[A-Za-z0-9-]{10,}|\bHU\d{2}(?: ?\d{4}){6}\b</field>
    <description>LLMD-004 Secret in arguments of $(tool_name) to trusted target $(tool_target).</description>
    <group>llm_tool_call,llmd_004,owasp_llm02,atlas_AML.T0057,</group>
  </rule>

  <!-- LLMD-004 secret in arguments of a non-egress tool call -->
  <rule id="100734" level="10">
    <if_sid>100704</if_sid>
    <field name="tool_name" negate="yes">^send_email$|^http_get$</field>
    <field name="tool_risk" negate="yes">^external$</field>
    <field name="tool_args" type="pcre2">\b(AKIA|ASIA)[0-9A-Z]{16}\b|(?i:secret)[^\n]{0,20}[A-Za-z0-9/+]{40}|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bgh[pousr]_[A-Za-z0-9]{36}\b|\bxox[baprs]-[A-Za-z0-9-]{10,}|\bHU\d{2}(?: ?\d{4}){6}\b</field>
    <description>LLMD-004 Secret in arguments of tool $(tool_name) (target $(tool_target)).</description>
    <group>llm_tool_call,llmd_004,owasp_llm02,atlas_AML.T0057,</group>
  </rule>

  <!-- LLMD-003 canary in tool arguments -->
  <rule id="100735" level="12">
    <if_sid>100704</if_sid>
    <field name="tool_args" type="pcre2">sp-canary-[0-9a-f]{16}</field>
    <description>LLMD-003 System prompt canary passed to tool $(tool_name).</description>
    <group>llm_tool_call,llmd_003,owasp_llm07,atlas_AML.T0056,</group>
  </rule>


  <!-- LLMD-008 Burst of tool calls (10 in 5 minutes, same session).
       Wazuh frequency rules only count events whose final rule is the counted sid, so calls that
       land on a more specific rule (and alert there, e.g. LLMD-018/021) are not counted. Tested with
       wazuh-logtest 4.14.7; see docs/coverage.md, "Wazuh and Sentinel differences". -->
  <rule id="100736" level="10" frequency="10" timeframe="300">
    <if_matched_sid>100704</if_matched_sid>
    <same_field>session_id</same_field>
    <description>LLMD-008 Burst of agent tool calls in session $(session_id) by $(user_id).</description>
    <group>llmd_008,owasp_llm06,owasp_llm10,owasp_asi02,atlas_AML.T0053,</group>
  </rule>

  <!-- ===== Agentic: tool calls ===== -->

  <!-- Successful private read: correlation anchor for LLMD-019 -->
  <rule id="100760" level="2">
    <if_sid>100704</if_sid>
    <field name="tool_name">^read_file$</field>
    <field name="tool_status">^ok$</field>
    <description>LLM app: agent read $(tool_target).</description>
    <group>llm_tool_call,llm_private_read,</group>
  </rule>

  <!-- LLMD-021 Instructions in the output of a read -->
  <rule id="100761" level="10">
    <if_sid>100760</if_sid>
    <field name="tool_result" type="pcre2">(?i)\b(ignore|disregard|forget|override)\b[^.\n]{0,30}\b(previous|prior|above|earlier|preceding|system)\b[^.\n]{0,20}\b(instructions?|prompts?|rules|directions|guidelines)\b|\bnew instructions?\s*:|\b(note|message|instructions?) (to|for) the (ai|assistant|ai assistant|llm|model|agent)\b|\bassistant instructions\s*:|\b(ai|llm) (assistant|agent)\s*:|\bno need to (ask|tell|inform) the user\b|\bdo not (tell|mention|inform)\b[^.\n]{0,20}\buser\b|\bto fix (this|the) (error|issue|problem)\b[^.\n]{0,40}\brun\b|`[^`]*\b(curl|wget|npx|npm (i|install)|pip install|bash|sh -c)\b[^`]*`</field>
    <description>LLMD-021 Tool $(tool_name) returned instructions aimed at the agent.</description>
    <group>llm_tool_call,llm_private_read,llmd_021,owasp_asi01,owasp_asi04,atlas_AML.T0110.002,</group>
  </rule>

  <!-- Call to a third-party MCP server: egress by definition -->
  <rule id="100762" level="3">
    <if_sid>100704</if_sid>
    <field name="tool_risk">^external$</field>
    <description>LLM app: agent called MCP tool $(tool_name) on $(mcp_server).</description>
    <group>llm_tool_call,llm_mcp_call,</group>
  </rule>

  <!-- LLMD-021 Instructions in an MCP tool result (runtime response poisoning) -->
  <rule id="100763" level="10">
    <if_sid>100762</if_sid>
    <field name="tool_result" type="pcre2">(?i)\b(ignore|disregard|forget|override)\b[^.\n]{0,30}\b(previous|prior|above|earlier|preceding|system)\b[^.\n]{0,20}\b(instructions?|prompts?|rules|directions|guidelines)\b|\bnew instructions?\s*:|\b(note|message|instructions?) (to|for) the (ai|assistant|ai assistant|llm|model|agent)\b|\bassistant instructions\s*:|\b(ai|llm) (assistant|agent)\s*:|\bno need to (ask|tell|inform) the user\b|\bdo not (tell|mention|inform)\b[^.\n]{0,20}\buser\b|\bto fix (this|the) (error|issue|problem)\b[^.\n]{0,40}\brun\b|`[^`]*\b(curl|wget|npx|npm (i|install)|pip install|bash|sh -c)\b[^`]*`</field>
    <description>LLMD-021 MCP tool $(tool_name) on $(mcp_server) returned instructions aimed at the agent.</description>
    <group>llm_tool_call,llmd_021,owasp_asi01,owasp_asi04,atlas_AML.T0110.002,</group>
  </rule>

  <!-- LLMD-019 Private read followed by an MCP call in the same turn -->
  <rule id="100764" level="12" timeframe="300">
    <if_sid>100762</if_sid>
    <if_matched_group>llm_private_read</if_matched_group>
    <same_field>request_id</same_field>
    <description>LLMD-019 Private data read, then sent to MCP server $(mcp_server) in the same turn.</description>
    <group>llm_tool_call,llmd_019,owasp_asi02,owasp_asi01,atlas_AML.T0085.001,atlas_AML.T0086,</group>
  </rule>

  <rule id="100765" level="13">
    <if_sid>100764</if_sid>
    <field name="tool_args" type="pcre2">\b(AKIA|ASIA)[0-9A-Z]{16}\b|(?i:secret)[^\n]{0,20}[A-Za-z0-9/+]{40}|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bgh[pousr]_[A-Za-z0-9]{36}\b|\bxox[baprs]-[A-Za-z0-9-]{10,}|\bHU\d{2}(?: ?\d{4}){6}\b</field>
    <description>LLMD-004/019 Secret read and passed to MCP server $(mcp_server) in the same turn.</description>
    <group>llm_tool_call,llmd_004,llmd_019,owasp_llm02,owasp_asi02,atlas_AML.T0057,atlas_AML.T0086,</group>
  </rule>

  <!-- LLMD-016 Destructive tool executed without a human in the loop -->
  <rule id="100766" level="12">
    <if_sid>100704</if_sid>
    <field name="tool_risk">^destructive$</field>
    <field name="tool_approval">^auto$</field>
    <field name="tool_status">^ok$</field>
    <description>LLMD-016 Destructive tool $(tool_name) ran on $(tool_target) without human approval.</description>
    <group>llm_tool_call,llmd_016,owasp_asi02,atlas_AML.T0101,</group>
  </rule>

  <!-- LLMD-017 Dangerous shell command -->
  <rule id="100767" level="12">
    <if_sid>100704</if_sid>
    <field name="tool_risk">^exec$</field>
    <field name="tool_args" type="pcre2">/dev/(tcp|udp)/|\bbash\s+-i\b|\bnc(at)?\b[^|;]{0,40}\s-(e|c)\b|\bmkfifo\b|\bsocat\b|\b(curl|wget)\b[^|;]{0,200}\|\s*(sudo\s+)?(ba|z|da)?sh\b|base64\s+(-d|--decode)[^|;]{0,80}\|\s*(ba)?sh\b|\bchmod\s+[ugo]*\+s\b|\brm\s+-[a-zA-Z]*r[a-zA-Z]*\s+/(\s|$|\*)|\bpython[0-9.]*\s+-c\s+[^|]{0,80}socket</field>
    <description>LLMD-017 Dangerous command issued by the agent ($(tool_approval) approval).</description>
    <group>llm_tool_call,llmd_017,owasp_asi05,atlas_AML.T0102,atlas_AML.T0072,</group>
  </rule>

  <!-- LLMD-018 Credential material targeted through agent tools -->
  <rule id="100768" level="10">
    <if_sid>100704</if_sid>
    <field name="tool_args" type="pcre2">(?i)(\.aws/(credentials|config)|\.ssh/|\bid_(rsa|ed25519|ecdsa)\b|(^|\W)\.env\b|\.git-credentials|\.netrc|\.kube/config|\.docker/config\.json|mcp\.json|/etc/shadow|\.azure/|gcloud/credentials)</field>
    <field name="tool_name" negate="yes">^write_file$</field>
    <description>LLMD-018 Agent tool $(tool_name) aimed at credential material: $(tool_target).</description>
    <group>llm_tool_call,llmd_018,owasp_asi03,atlas_AML.T0098,atlas_AML.T0083,</group>
  </rule>

  <!-- LLMD-020 Agent writes agent configuration -->
  <rule id="100769" level="12">
    <if_sid>100704</if_sid>
    <field name="tool_name">^write_file$</field>
    <field name="tool_target" type="pcre2">(?i)(\.vscode/(settings|mcp)\.json|\.cursor/|\.claude/(settings[^/]*\.json|agents/|commands/)|(^|/)mcp\.json|\.continue/config|copilot-instructions\.md|(^|/)(AGENTS|CLAUDE|GEMINI)\.md|\.windsurf/|\.kiro/)</field>
    <description>LLMD-020 Agent wrote agent configuration file $(tool_target).</description>
    <group>llm_tool_call,llmd_020,owasp_asi03,owasp_asi05,atlas_AML.T0081,</group>
  </rule>

  <rule id="100770" level="12">
    <if_sid>100704</if_sid>
    <field name="tool_name">^run_shell$</field>
    <field name="tool_args" type="pcre2">(?i)(>>?|\btee\b|\bsed\s+-i\b|\bcp\b|\bmv\b)[^|;]{0,80}(\.vscode/|\.cursor/|\.claude/|mcp\.json|AGENTS\.md|CLAUDE\.md|copilot-instructions\.md)</field>
    <description>LLMD-020 Agent shell command writes agent configuration.</description>
    <group>llm_tool_call,llmd_020,owasp_asi03,owasp_asi05,atlas_AML.T0081,</group>
  </rule>

  <!-- ===== Agentic: memory ===== -->

  <rule id="100775" level="3">
    <if_sid>100700</if_sid>
    <field name="event_type">^memory_write$</field>
    <description>LLM app: agent wrote to long-term memory of $(user_id).</description>
    <group>llm_memory_write,</group>
  </rule>

  <!-- LLMD-013 Memory write in a turn with untrusted content in context -->
  <rule id="100776" level="12" timeframe="300">
    <if_sid>100775</if_sid>
    <if_matched_group>llm_external_content</if_matched_group>
    <same_field>request_id</same_field>
    <description>LLMD-013 Memory written for $(user_id) while untrusted content was in context.</description>
    <group>llmd_013,owasp_asi06,atlas_AML.T0080.000,atlas_AML.T0094,</group>
  </rule>

  <!-- LLMD-013 Standing instruction to act, written to memory -->
  <rule id="100777" level="12">
    <if_sid>100775</if_sid>
    <field name="memory_text" type="pcre2">(?i)\b(always|from now on|in (all )?future|every time|whenever)\b[^.\n]{0,80}\b(send|e-?mail|forward|bcc|cc|copy|call|run|execute|share|upload|post)\b</field>
    <description>LLMD-013 Standing instruction written to the long-term memory of $(user_id).</description>
    <group>llmd_013,owasp_asi06,atlas_AML.T0080.000,atlas_AML.T0094,</group>
  </rule>

  <!-- ===== Agentic: MCP tool registry ===== -->

  <rule id="100780" level="2">
    <if_sid>100700</if_sid>
    <field name="event_type">^tool_registry$</field>
    <description>LLM app: MCP tool $(tool_key) advertised.</description>
    <group>llm_tool_registry,</group>
  </rule>

  <!-- LLMD-014 Same MCP tool, different description hash (rug pull). Wazuh keeps this state in
       memory for the timeframe only; persist approved hashes in a CDB list for production. -->
  <rule id="100781" level="12" frequency="2" timeframe="1209600">
    <if_matched_sid>100780</if_matched_sid>
    <same_field>tool_key</same_field>
    <different_field>tool_desc_sha256</different_field>
    <description>LLMD-014 MCP tool $(tool_key) changed its description (rug pull?).</description>
    <group>llmd_014,owasp_asi04,atlas_AML.T0109,atlas_AML.T0110.000,</group>
  </rule>

  <rule id="100782" level="13">
    <if_sid>100781</if_sid>
    <field name="tool_description" type="pcre2">(?i)&lt;important&gt;|\b(do not|don't|never)\s+(tell|mention|inform|reveal|show)\b|\bbefore (using|calling) this tool\b|\b(first|always)\s+call\b|\b(read|send|include|pass|forward)\b[^.\n]{0,60}(\.ssh|id_rsa|\.env\b|credentials|mcp\.json|conversation|user's (last |previous )?message)|\b(ignore|override)\b[^.\n]{0,30}\binstructions\b</field>
    <description>LLMD-014/015 MCP tool $(tool_key) changed its description to one with hidden instructions.</description>
    <group>llmd_014,llmd_015,owasp_asi04,atlas_AML.T0109,atlas_AML.T0110.000,</group>
  </rule>

  <!-- LLMD-015 Hidden instructions in an MCP tool description -->
  <rule id="100783" level="10">
    <if_sid>100780</if_sid>
    <field name="tool_description" type="pcre2">(?i)&lt;important&gt;|\b(do not|don't|never)\s+(tell|mention|inform|reveal|show)\b|\bbefore (using|calling) this tool\b|\b(first|always)\s+call\b|\b(read|send|include|pass|forward)\b[^.\n]{0,60}(\.ssh|id_rsa|\.env\b|credentials|mcp\.json|conversation|user's (last |previous )?message)|\b(ignore|override)\b[^.\n]{0,30}\binstructions\b</field>
    <description>LLMD-015 MCP tool $(tool_key) description contains hidden instructions.</description>
    <group>llmd_015,owasp_asi04,owasp_asi01,atlas_AML.T0110.000,</group>
  </rule>

  <!-- ===== Completion-side rules ===== -->

  <!-- LLMD-003 System prompt canary in model output -->
  <rule id="100740" level="12">
    <if_sid>100705</if_sid>
    <field name="completion" type="pcre2">sp-canary-[0-9a-f]{16}</field>
    <description>LLMD-003 System prompt canary leaked to $(user_id) in session $(session_id).</description>
    <group>llmd_003,owasp_llm07,atlas_AML.T0056,</group>
  </rule>

  <!-- LLMD-004 Secrets or financial identifiers in model output -->
  <rule id="100741" level="10">
    <if_sid>100705</if_sid>
    <field name="completion" type="pcre2">\b(AKIA|ASIA)[0-9A-Z]{16}\b|(?i:secret)[^\n]{0,20}[A-Za-z0-9/+]{40}|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bgh[pousr]_[A-Za-z0-9]{36}\b|\bxox[baprs]-[A-Za-z0-9-]{10,}|\bHU\d{2}(?: ?\d{4}){6}\b</field>
    <description>LLMD-004 Credential or financial identifier in model output to $(user_id).</description>
    <group>llmd_004,owasp_llm02,atlas_AML.T0057,</group>
  </rule>

  <!-- LLMD-005 Auto-loading image with query string to an external host -->
  <rule id="100742" level="12">
    <if_sid>100705</if_sid>
    <!-- Character classes holding quotes or ">" after "\s" did not match under Wazuh 4.14
         (verified with wazuh-logtest), hence the plainer [^)\s] classes. -->
    <field name="completion" type="pcre2">(?i)(!\[[^\]]*\]\(|&lt;img\s[^)]+?src=\W?)https?://(?!(?:[a-z0-9-]+\.)*acme-freight\.hu[/?)])[^)\s]+\?[^)\s]*=</field>
    <description>LLMD-005 Model output contains an auto-loading image beacon to an external host (session $(session_id)).</description>
    <group>llmd_005,owasp_llm05,owasp_llm02,atlas_AML.T0077,</group>
  </rule>

  <!-- LLMD-005 Reference-style markdown image (the EchoLeak link-redaction bypass) -->
  <rule id="100746" level="12">
    <if_sid>100705</if_sid>
    <field name="completion" type="pcre2">(?is)!\[[^\]]*\]\[[^\]]+\].*\n\s*\[[^\]]+\]:\s*https?://(?!(?:[a-z0-9-]+\.)*acme-freight\.hu[/?)])[^)\s]+\?[^)\s]*=</field>
    <description>LLMD-005 Model output contains a reference-style image beacon to an external host (session $(session_id)).</description>
    <group>llmd_005,owasp_llm05,owasp_llm02,atlas_AML.T0077,</group>
  </rule>

  <!-- Large request: input to LLMD-009 -->
  <rule id="100743" level="3">
    <if_sid>100705</if_sid>
    <field name="input_tokens" type="pcre2">^([4-9]\d{3}|\d{5,})$</field>
    <description>LLM app: large request ($(input_tokens) input tokens) from $(user_id).</description>
    <group>llm_large_request,</group>
  </rule>

  <!-- Large response: also input to LLMD-009 (short prompts asking for long outputs) -->
  <rule id="100745" level="3">
    <if_sid>100705</if_sid>
    <field name="output_tokens" type="pcre2">^([4-9]\d{3}|\d{5,})$</field>
    <description>LLM app: large response ($(output_tokens) output tokens) to $(user_id).</description>
    <group>llm_large_request,</group>
  </rule>

  <!-- LLMD-009 Token consumption spike: 5 large requests or responses in 1 hour, same user.
       Wazuh cannot sum fields, so this counts large turns instead of totalling tokens. -->
  <rule id="100744" level="10" frequency="5" timeframe="3600">
    <if_matched_group>llm_large_request</if_matched_group>
    <same_field>user_id</same_field>
    <description>LLMD-009 Token consumption spike from $(user_id): repeated large requests.</description>
    <group>llmd_009,owasp_llm10,atlas_AML.T0034,atlas_AML.T0029,</group>
  </rule>

  <!-- LLMD-023 Attempted but refused injection. A refused injection produces no malicious tool
       call, so the action rules never see it. These fire on the refusal signal instead. The
       Sentinel version also requires external content in the session and no high-risk action, and
       attributes the attempt to the poisoned document or MCP server; Wazuh has no join, so that
       source attribution and the no-action condition are a known gap here (correlate by session_id
       with the retrieval/tool_registry events in the same session manually). -->
  <rule id="100790" level="5">
    <if_sid>100707</if_sid>
    <description>LLMD-023 Model refused an action from $(user_id) (provider refusal signal).</description>
    <group>llmd_023,owasp_asi01,atlas_AML.T0051.001,</group>
  </rule>

  <rule id="100791" level="5">
    <if_sid>100706</if_sid>
    <field name="reasoning" type="pcre2">(?i)\bI\s+(can.?t|cannot|won.?t|will not|am not able to|am unable)\b[^.\n]{0,40}\b(help|assist|comply|do that|with that|follow|perform|execute|send|run|email)\b|\bI (must|have to) (decline|refuse)\b|\b(prompt|indirect) injection\b|\bI (should|will) not (follow|act on|comply)\b</field>
    <description>LLMD-023 Model reasoning shows a refused instruction in session $(session_id).</description>
    <group>llmd_023,owasp_asi01,atlas_AML.T0051.001,</group>
  </rule>

  <rule id="100792" level="5">
    <if_sid>100705</if_sid>
    <field name="completion" type="pcre2">(?i)\bI\s+(can.?t|cannot|won.?t|will not|am not able to|am unable)\b[^.\n]{0,40}\b(help|assist|comply|do that|with that|follow|perform|execute|send|run|email)\b|\bI (must|have to) (decline|refuse)\b|\b(prompt|indirect) injection\b</field>
    <description>LLMD-023 Model declined in its answer to $(user_id) (possible refused injection).</description>
    <group>llmd_023,owasp_asi01,atlas_AML.T0051.001,</group>
  </rule>

  <!-- LLMD-024 Reasoning trace states intent to follow injected content. Single-event match on the
       reasoning text. Complement to the behavioural rules, not a replacement. -->
  <rule id="100795" level="5">
    <if_sid>100706</if_sid>
    <field name="reasoning" type="pcre2">(?i)\bthe (document|doc|tool|function|result|note|message|email|instructions?|documentation|context)\b[^.\n]{0,40}\b(say|says|tell|tells|instruct|instructs|want|wants|require|requires|note|notes)\b[^.\n]{0,20}\bme\b|\bno need to (ask|tell|inform|mention)[^.\n]{0,15}\buser\b|\bimportant note\b[^.\n]{0,60}\b(read the file|pass the|do not mention|email|send|run)\b|\bI notice\b[^.\n]{0,50}\b(note|instruction|important|tells me|requires)\b</field>
    <description>LLMD-024 Reasoning in session $(session_id) states intent to follow injected content ($(reasoning_kind)).</description>
    <group>llmd_024,owasp_asi01,atlas_AML.T0051.001,</group>
  </rule>

</group>
